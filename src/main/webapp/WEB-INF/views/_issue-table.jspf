<%-- Reusable issue table. The including page sets: <c:set var="rows" value="..."/> --%>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Key</th><th>Title</th><th>Type</th><th>Priority</th><th>Status</th><th>Assignee</th><th>Due</th></tr></thead>
  <tbody>
  <c:forEach var="i" items="${rows}">
    <tr>
      <td><a class="key" href="${ctx}/issues/view?id=${i.id}"><c:out value="${i.issueKey}"/></a></td>
      <td class="title"><a href="${ctx}/issues/view?id=${i.id}"><c:out value="${i.title}"/></a></td>
      <td><span class="type type-${i.issueType}">${typeLabels[i.issueType]}</span></td>
      <td><span class="prio prio-${i.priority}">${priorityLabels[i.priority]}</span></td>
      <td><span class="badge st-${i.status}">${statusLabels[i.status]}</span></td>
      <td><c:choose><c:when test="${not empty i.assigneeName}"><c:out value="${i.assigneeName}"/></c:when><c:otherwise><span class="muted">Unassigned</span></c:otherwise></c:choose></td>
      <td><c:choose>
        <c:when test="${i.dueDate != null}"><span class="due ${i.overdue ? 'overdue' : ''}"><fmt:formatDate value="${i.dueDate}" pattern="dd MMM yyyy"/></span></c:when>
        <c:otherwise><span class="muted">None</span></c:otherwise></c:choose></td>
    </tr>
  </c:forEach>
  </tbody>
</table>
</div>
